# Single source of truth for every environment variable in this repo.
# Copy to the right place per service:
#   frontend/.env.local      -> frontend dev
#   backend/.env             -> backend dev (teammate's lane)
#   Vercel / Render dashboards -> deployed services
# NEVER commit real credentials.

# ---------- Frontend (Next.js) ----------
# "mock" replays frozen fixtures; a URL points the UI at the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=mock

# ---------- Backend (FastAPI) ----------
# FalkorDB: local Docker dev = localhost:6379 (no credentials);
# FalkorDB Cloud free tier = console endpoint/port + username/password, TLS OFF.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false

# LLM: any OpenAI-compatible endpoint. Examples:
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  (verify current URL)
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1                                 (local experiments only)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional lightweight abuse guard on mutating endpoints (stretch).
BACKEND_API_TOKEN=
