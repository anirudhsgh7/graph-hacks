# Single source of truth for every environment variable in this repo.
# Copy to the right place per service:
#   frontend/.env.local      -> frontend dev (see also frontend/.env.example)
#   backend/.env             -> backend dev (full list: backend/.env.example)
#   Vercel / Render dashboards -> deployed services
# NEVER commit real credentials.

# ---------- Frontend (Next.js) ----------
# "mock" replays the recorded fixtures in frontend/lib/mocks/; a URL points the
# UI at the FastAPI backend (local: http://localhost:8000).
NEXT_PUBLIC_API_BASE_URL=mock
# Copy of the backend's BACKEND_API_TOKEN when that is set (needed so the
# browser can call POST /api/actions/execute). Leave empty when the backend
# has no token.
NEXT_PUBLIC_BACKEND_API_TOKEN=

# ---------- Backend (FastAPI) ----------
# FalkorDB: local Docker dev = localhost:6379 (no credentials);
# FalkorDB Cloud free tier = console endpoint/port + username/password, TLS OFF.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false
FALKORDB_GRAPH=ftm

# LLM: any OpenAI-compatible endpoint. Current setup: OpenRouter free models —
# a tool-capable primary plus a second model as fallback (free ids rotate;
# re-check tool calling when changing them). Leave LLM_API_KEY empty for
# rule-based mode - no external calls.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Fallback - used automatically when the primary is rate-limited or down.
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=cohere/north-mini-code:free
# Longest wait honoured when a provider answers 429 with "retry after N s".
LLM_MAX_WAIT_S=20

# HTTP
# Comma-separated frontend origins allowed to call the API
# (FalkorDB Browser uses :3000, so run the frontend on :3001 if both are up).
CORS_ORIGINS=http://localhost:3000
# Required header on POST /api/actions/execute and /api/admin/reseed when set.
BACKEND_API_TOKEN=
