# Copy to frontend/.env.local (git-ignored). Restart `npm run dev` after edits —
# builds inline NEXT_PUBLIC_* at compile time.

# "mock" replays the recorded fixtures in lib/mocks/ (default, no backend needed);
# a URL points the UI at the FastAPI backend (local: http://localhost:8000).
NEXT_PUBLIC_API_BASE_URL=mock

# Set only when the backend runs with BACKEND_API_TOKEN configured — the browser
# then includes it as a Bearer token on POST /api/actions/execute.
NEXT_PUBLIC_BACKEND_API_TOKEN=
