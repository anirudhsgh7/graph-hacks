# Frontend environment — copy to .env.local (git-ignored) and adjust.
#
# "mock" replays the frozen fixtures in lib/mocks (no backend needed — default).
# Point it at the FastAPI backend to go live, e.g. http://localhost:8000 (dev)
# or https://<your-render-service>.onrender.com (deployed).
NEXT_PUBLIC_API_BASE_URL=mock
