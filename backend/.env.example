# Copy to backend/.env (git-ignored) and fill in. Never commit real values.

# --- FalkorDB -------------------------------------------------------------
# Local Docker: localhost / 6379, no username or password.
# FalkorDB Cloud (free tier): use the endpoint from the console; username is "falkordb";
# the free tier has no TLS, so keep FALKORDB_TLS=false.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false
FALKORDB_GRAPH=ftm

# --- LLM (any OpenAI-compatible endpoint) ----------------------------------
# Leave LLM_API_KEY empty to run the rule-based investigator (no external calls).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# gpt-oss reasoning tokens count against Groq's 8K tokens/min; keep them low.
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=30
# Gemini fallback - used automatically when the primary is rate-limited or down
# (free key: https://aistudio.google.com/apikey). GEMINI_API_KEY works as the key too.
# Model ids and free-tier quotas change; check AI Studio's rate-limit page for yours.
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gemini-flash-lite-latest
# Longest wait honoured when a provider answers 429 with "retry after N s".
LLM_MAX_WAIT_S=20

# --- Agent limits ----------------------------------------------------------
AGENT_MAX_TURNS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_BUDGET_S=45

# --- HTTP ------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Required header on POST /api/actions/execute and /api/admin/reseed when set:
#   Authorization: Bearer <BACKEND_API_TOKEN>
BACKEND_API_TOKEN=
INVESTIGATE_RATE_PER_MIN=10
