# Copy to backend/.env (git-ignored) and fill in. Never commit real values.

# --- FalkorDB -------------------------------------------------------------
# Local Docker: localhost / 6379, no username or password.
# FalkorDB Cloud (free tier): use the endpoint from the console; username is "falkordb";
# the free tier has no TLS, so keep FALKORDB_TLS=false.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false
FALKORDB_GRAPH=ftm

# --- LLM (any OpenAI-compatible endpoint) ----------------------------------
# Leave LLM_API_KEY empty to run the rule-based investigator (no external calls).
# Current setup: OpenRouter free models - a tool-capable primary and a second
# model as fallback (different providers behind the same gateway; free ids
# rotate, so re-check tool calling when changing them).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_TIMEOUT_S=30
# Fallback provider - used automatically when the primary is rate-limited or down.
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=cohere/north-mini-code:free
# Longest wait honoured when a provider answers 429 with "retry after N s".
LLM_MAX_WAIT_S=20

# --- Agent limits ----------------------------------------------------------
AGENT_MAX_TURNS=6
AGENT_MAX_TOOL_CALLS=12
# Wall-clock budget per investigation. Slow free-tier models need more than 45 s
# (render.yaml pins 90) or a run falls back to the planner mid-investigation.
AGENT_BUDGET_S=45

# --- HTTP ------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Required header on POST /api/actions/execute and /api/admin/reseed when set:
#   Authorization: Bearer <BACKEND_API_TOKEN>
BACKEND_API_TOKEN=
INVESTIGATE_RATE_PER_MIN=10
